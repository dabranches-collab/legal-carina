{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "legal-carina",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-16",
  "cache": { "enabled": false },
  "ratelimits": [{ "name": "TRANSLATION_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "build": {
    "command": "node ./scripts/build-production.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
